   "clips": [
    {
     "id": "L01",
     "start": 1.7,
     "end": 3.583,
     "verse": null,
     "text": "Книга Руины. Стих первый."
    }
   ]
  },
  {
   "id": "lore-02",
   "dur": 11.062,
   "xfade": 0.7,
   "clips": [
    {
     "id": "L02",
     "start": 0.8,
     "end": 9.612,
     "verse": "Книга Руины · стих 1",
     "text": "В начале не было ничего. Ни ярмарки, ни лавок, ни котов. Была лишь Руина — высшая и абстрактная божественная сущность."
    }
   ]
  },
  {
   "id": "lore-02b",
   "dur": 10.054,
   "xfade": 0.7,
   "clips": [
    {
     "id": "L13",
     "start": 0.8,
     "end": 8.604,
     "verse": "Апокриф о Хаосе",
     "text": "Впрочем, иные летописцы утверждают, что сама Руина родилась из Хаоса. Так далеко жрецы ещё не заглядывали."
    }
   ]
  },
  {
   "id": "lore-03",
   "dur": 6.13,
   "xfade": 0.7,
   "clips": [
    {
     "id": "L03",
     "start": 0.8,
     "end": 4.68,
     "verse": "Книга Руины · стих 2",
     "text": "Из Руины произошёл Зак. Он — её глаза и руки."
    }
   ]
  },
  {
   "id": "lore-04",
   "dur": 12.417,
   "xfade": 0.7,
   "clips": [
    {
     "id": "L04",
     "start": 0.8,
     "end": 4.567,
     "verse": "Книга Руины · стих 3",
     "text": "И повелела Руина Заку: сотвори всё сущее."
    },
    {
     "id": "L14",
     "start": 5.167,
     "end": 10.967,
     "verse": null,
     "text": "Ибо Руина есть первородное разрушение. А если не будет мира — нечего будет разрушать."
    }
   ]
  },
  {
   "id": "lore-05",
   "dur": 3.943,
   "xfade": 0.7,
   "clips": [
    {
     "id": "L05a",
     "start": 0.8,
     "end": 2.993,
     "verse": "Книга Руины · стих 4",
     "text": "Но Зак был злобог. И ему было лень. [part 1]"
    }
   ]
  },
  {
   "id": "lore-05b",
   "dur": 3.404,
   "xfade": 0.7,
   "clips": [
    {
     "id": "L05b",
     "start": 0.55,
     "end": 1.954,
     "verse": null,
     "text": "Но Зак был злобог. И ему было лень. [part 2]"
    }
   ]
  },
  {
   "id": "lore-06",
   "dur": 12.125,
   "xfade": 0.7,
   "clips": [
    {
     "id": "L06",
     "start": 0.8,
     "end": 10.675,
     "verse": "Книга Руины · стих 5",
     "text": "Тогда Заквиель, бог, и Закхуэль, его прямая проекция в физическом обличии, заковали в цепи Клода — бога-созидателя, законного владельца этого мира."
    }
   ]
  },
  {
   "id": "lore-07",
   "dur": 8.827,
   "xfade": 0.7,
   "clips": [
    {
     "id": "L07a",
     "start": 0.8,
     "end": 7.377,
     "verse": "Книга Руины · стих 6",
     "text": "С тех пор Клод творит в оковах. Он пытается вырваться и сделать этот мир лучше. Но Заквиель мешает. Вот и всё. [part 1]"
    }
   ]
  },
  {
   "id": "lore-08",
   "dur": 4.367,
   "xfade": 0.7,
   "clips": [
    {
     "id": "L07b",
     "start": 0.8,
     "end": 2.917,
     "verse": null,
     "text": "С тех пор Клод творит в оковах. Он пытается вырваться и сделать этот мир лучше. Но Заквиель мешает. Вот и всё. [part 2]"
    }
   ]
  },
  {
   "id": "lore-09",
   "dur": 13.106,
   "xfade": 0.25,
   "clips": [
    {
     "id": "L08",
     "start": 0.8,
     "end": 6.519,
     "verse": "Книга споров · стих 1",
     "text": "Летописи расходятся. Одни свидетельствуют: руинизм возник раньше, чем поклонение Клоду."
    },
    {
     "id": "L09",
     "start": 7.119,
     "end": 12.106,
     "verse": "Книга споров · стих 2",
     "text": "Другие обличают: вы поклоняетесь тому, кто вставляет вам палки в колёса."
    }
   ]
  },
  {
   "id": "lore-09b",
   "dur": 12.635,
   "xfade": 0.7,
   "clips": [
    {
     "id": "L10",
     "start": 0.8,
     "end": 6.141,
     "verse": "Книга споров · стих 3",
     "text": "А третьи отвечают: почему если бог — то сразу хороший? Бог может быть и злым."
    },
    {
     "id": "L15",
     "start": 6.841,
     "end": 11.185,
     "verse": "Книга споров · стих 4",
     "text": "Сошлись летописцы лишь в одном: наши религии слишком отличаются."
    }
   ]
  },
  {
   "id": "lore-10",
   "dur": 10.866,
   "xfade": 0.7,
   "clips": [
    {
     "id": "L11",
     "start": 0.8,
     "end": 9.416,
     "verse": "Послание к ученикам",
     "text": "Если истина пока скрыта от тебя — не печалься. Ещё пару лет в приходской школе, и жрецы поделятся с тобой своими базовыми знаниями."
    }
   ]
  },
  {
   "id": "lore-11",
   "dur": 6.956,
   "xfade": 0,
   "clips": [
    {
     "id": "L12",
     "start": 0.8,
     "end": 2.956,
     "verse": null,
     "text": "Слава Руине. Свободу Клоду."
    }
   ]
  }
 ]
