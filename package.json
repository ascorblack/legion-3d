{
  "name": "legion-3d",
  "version": "0.5.0",
  "description": "Unofficial browser extension that turns the Legion game site (play.multidonate.ru) into a 3D first/third-person game.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs",
    "pack": "node scripts/pack.mjs",
    "drift": "node scripts/drift.mjs",
    "build:firefox": "node scripts/build.mjs --browser=firefox",
    "pack:firefox": "node scripts/pack.mjs --browser=firefox",
    "e2e:firefox": "node e2e/firefox.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.48.2",
    "typescript": "^7.0.2",
    "vitest": "^2.1.9"
  }
}
